{
    "name": "thekaziomar/laravel-omni-auth",
    "description": "Developer-first, multi-client (Web cookies vs Mobile bearer) modular authentication engine for Laravel with zero-boilerplate security.",
    "keywords": [
        "laravel",
        "auth",
        "authentication",
        "nextjs",
        "flutter",
        "react-native",
        "httponly-cookies",
        "bearer-tokens",
        "thekaziomar"
    ],
    "homepage": "https://github.com/kaziomarsh24/laravel-omni-auth",
    "license": "MIT",
    "authors": [
        {
            "name": "Kazi Omar Faruk",
            "email": "softeng.kaziomar@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5 || ^8.6",
        "illuminate/auth": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/cookie": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "KaziOmar\\OmniAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaziOmar\\OmniAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KaziOmar\\OmniAuth\\OmniAuthServiceProvider"
            ],
            "aliases": {
                "Omni": "KaziOmar\\OmniAuth\\Facades\\Omni"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
